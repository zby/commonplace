{
  "permissions": {
    "allow": [
      "Bash(commonplace-*)",
      "Bash(*/.venv/bin/commonplace-*)",
      "Bash(rg)",
      "Bash(rg *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-setup.sh"
          }
        ]
      }
    ]
  }
}
